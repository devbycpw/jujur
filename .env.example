# Salin ke .env. Di Vercel, isi variabel yang sama untuk Production.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
CRON_SECRET=buat-string-acak-yang-panjang

# Dibutuhkan oleh peramban (Client Component / Browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Opsional. Kosongkan agar tahun mengikuti tahun berjalan.
RUP_YEAR=
